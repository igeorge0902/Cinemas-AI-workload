# Ignore everything
*

# Allow directories (needed so Git can traverse them)
!*/

# Allow specific files or folders
!.github
!.ai
!.ai/**
!k6/
!k6/api2.js
!k6/README.md
!k6/api2.properties.example

# Local per-request agent routing and usage telemetry
.ai/generated/routing-telemetry/

# GitHub discovers canonical agent definitions through symlinks here.
!.github/agents/
!.github/agents/**

# Local developer launchers
!scripts/
!scripts/dev-backends.sh
!scripts/README.md
/mbook-quarkus/.mvn/
/.idea/
/.dev-logs/
